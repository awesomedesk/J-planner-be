<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />

  <property name="CONSOLE_LOG_PATTERN"
    value="[%d{yyyy-MM-dd HH:mm:ss}:%-3relative]  %clr(%-5level) %clr(${PID:-}){magenta} %clr(---){faint} %clr([%15.15thread]){faint} %clr(%-40logger{36}){cyan} %clr(:){faint} %msg%n"/>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <layout class="ch.qos.logback.classic.PatternLayout">
      <Pattern>${CONSOLE_LOG_PATTERN}</Pattern>
    </layout>
  </appender>

  <property name="FILE_LOG_PATTERN"
    value="[%d{yyyy-MM-dd HH:mm:ss}:%-3relative] %-5level ${PID:-} --- [%15.15thread] %-40logger{36} : %msg%n"/>
  <property name="LOGS_ABSOLUTE_PATH" value="./logs" />
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOGS_ABSOLUTE_PATH}/logback.log</file>
    <encoder>
      <pattern>${FILE_LOG_PATTERN}</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOGS_ABSOLUTE_PATH}/logFile.%d{yyyy-MM-dd_HH-mm-ss}.log</fileNamePattern>
      <maxHistory>720</maxHistory>
      <totalSizeCap>3GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <root level="debug">
    <appender-ref ref="STDOUT" />
  </root>

  <!-- log 레벨 설정 (org.springframework.web=info)-->
  <logger name="org.springframework.web" level="info">
    <appender-ref ref="FILE" />
  </logger>

  <!-- spring profile별 로그 설정 -->
  <springProfile name="local">
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
      <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="false">
      <appender-ref ref="STDOUT"/>
    </logger>

    <root level="debug">
      <appender-ref ref="STDOUT" />
    </root>
  </springProfile>

  <springProfile name="tst">
    <root level="info">
      <appender-ref ref="STDOUT" />
    </root>
    <logger name="org.springframework.web" level="info">
      <appender-ref ref="FILE" />
    </logger>
  </springProfile>

  <springProfile name="prd">
    <root level="error">
      <appender-ref ref="STDOUT" />
    </root>
    <logger name="org.springframework.web" level="error">
      <appender-ref ref="FILE" />
    </logger>
  </springProfile>
</configuration>
